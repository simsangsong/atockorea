# QA 캡처는 전부 무시한다. 하나씩 적으면 다음에 만드는 디렉터리가 반드시 빠진다.
.qa-shots-*/

# QA 하니스가 남기는 로컬 산출물 (서명 토큰·응답 본문 포함 — 커밋 금지)
scripts/.sim-fixtures.json
scripts/.qa-prod-*.json

# video-guide build artefacts
out/
# 🔴 위 out/ 는 경로가 없어 i18n-work/out/ 까지 잡는다. 그쪽은 번역 산출물이고,
#    잃으면 API 크레딧을 다시 써서 만들어야 한다 — extract 결과(in/)는 이미 추적 중이다.
!i18n-work/out/
.cache/
assets/audio/video-guide/

# QA walk artifacts (screenshots, regenerated on demand)
scripts/.walk-*/

# QA harness output — failure screenshots from scripts/qa-hero-grid.mjs
# (SHOT_DIR defaults to the repo root, so a bare run drops them here)
hero-grid/

# QA walk output — screenshots + measurements, regenerated on demand
cockpit/
shots/

# beat-sheet scratch output
.beat-sheets/
