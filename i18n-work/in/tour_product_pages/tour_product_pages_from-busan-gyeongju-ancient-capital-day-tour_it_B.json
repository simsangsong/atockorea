  "segments": {
    "/routePhases/0/phase": {
      "source_en": "Outbound + Ahopsan",
      "tm": "Andata + Ahopsan"
    },
    "/routePhases/0/duration": {
      "source_en": "≈ 2.5 hours",
      "tm": "≈ 2,5 ore"
    },
    "/routePhases/0/description": {
      "source_en": "Pickup at three Busan subway stations (Busan Station Exit 4 at 08:10, Seomyeon Station Exit 4 at 08:30, Haeundae Station Exit 5 at 09:10), then ≈30 min to ⟦G0⟧ in Gijang and a 60-minute walk along the bamboo paths.",
      "tm": "Prelievo presso tre stazioni della metropolitana di Busan (Busan Station uscita 4 alle 08:10, Seomyeon Station uscita 4 alle 08:30, Haeundae Station uscita 5 alle 09:10), poi ≈30 min fino a ⟦G0⟧ a Gijang e una passeggiata di 60 minuti lungo i sentieri di bambù.",
      "glossary": [
        "⟦G0⟧ = Foresta di bambù di Ahopsan"
      ]
    },
    "/routePhases/1/phase": {
      "source_en": "UNESCO core",
      "tm": "Nucleo UNESCO"
    },
    "/routePhases/1/duration": {
      "source_en": "≈ 2 hours",
      "tm": "≈ 2 ore"
    },
    "/routePhases/1/description": {
      "source_en": "Drive ≈50 min from Ahopsan to Bulguksa, then 75 minutes walking the temple at a relaxed pace.",
      "tm": "Trasferimento di ≈50 min da Ahopsan a Bulguksa, poi 75 minuti di visita a piedi del tempio con andatura tranquilla."
    },
    "/routePhases/2/phase": {
      "source_en": "Lunch",
      "tm": "Pranzo"
    },
    "/routePhases/2/duration": {
      "source_en": "≈ 1 hour",
      "tm": "≈ 1 ora"
    },
    "/routePhases/2/description": {
      "source_en": "Regional food such as ssambap at a local restaurant in central Gyeongju (≈55 min, paid individually).",
      "tm": "Cucina regionale come lo ssambap in un ristorante locale nel centro di Gyeongju (≈55 min, a pagamento individuale)."
    },
    "/routePhases/3/phase": {
      "source_en": "Gyeongju walking block 1 — head family and bridge",
      "tm": "Blocco a piedi 1 a Gyeongju — casa del ramo principale e ponte"
    },
    "/routePhases/3/duration": {
      "source_en": "≈ 1.5 hours",
      "tm": "≈ 1,5 ore"
    },
    "/routePhases/3/description": {
      "source_en": "From ⟦G0⟧ and the Choi Family House along the Namcheon riverside to ⟦G1⟧ — 75 minutes on a single drop-off.",
      "tm": "Da ⟦G0⟧ e dalla Choi Family House lungo il fiume Namcheon fino a ⟦G1⟧ — 75 minuti con un unico punto di discesa.",
      "glossary": [
        "⟦G0⟧ = Villaggio hanok di Gyochon",
        "⟦G1⟧ = Ponte di Woljeonggyo"
      ]
    },
    "/routePhases/4/phase": {
      "source_en": "Gyeongju walking block 2 — royal tombs and cafe street",
      "tm": "Blocco a piedi 2 a Gyeongju — tombe reali e via dei caffè"
    },
    "/routePhases/4/duration": {
      "source_en": "≈ 1.5 hours",
      "tm": "≈ 1,5 ore"
    },
    "/routePhases/4/description": {
      "source_en": "A walk among the Daereungwon mounds, then over the west wall into Hwangnidan-gil — 75 minutes on a single drop-off.",
      "tm": "Una passeggiata tra i tumuli di Daereungwon, poi oltre le mura occidentali fino a Hwangnidan-gil — 75 minuti con un unico punto di discesa."
    },
    "/routePhases/5/phase": {
      "source_en": "Final stop + return",
      "tm": "Ultima tappa + rientro"
    },
    "/routePhases/5/duration": {
      "source_en": "≈ 2.5 hours",
      "tm": "≈ 2,5 ore"
    },
    "/routePhases/5/description": {
      "source_en": "60 minutes at ⟦G0⟧ (Nov–Feb: Donggung & Wolji by night), then back to Busan on the Gyeongbu Expressway — Haeundae ≈19:15, Seomyeon ≈19:35, Busan Station ≈19:50.",
      "tm": "60 minuti a ⟦G0⟧ (da novembre a febbraio: Donggung e Wolji in notturna), poi rientro a Busan lungo la Gyeongbu Expressway — Haeundae ≈19:15, Seomyeon ≈19:35, Busan Station ≈19:50.",
      "glossary": [
        "⟦G0⟧ = Museo nazionale di Gyeongju"
      ]
    },
