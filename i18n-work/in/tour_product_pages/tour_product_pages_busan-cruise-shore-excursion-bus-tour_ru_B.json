{
  "unitId": "tour_product_pages:busan-cruise-shore-excursion-bus-tour:ru:B",
  "surface": "tour_product_pages",
  "slug": "busan-cruise-shore-excursion-bus-tour",
  "locale": "ru",
  "chunk": "B",
  "tier": "B",
  "segments": {
    "/routePhases/0/phase": {
      "source_en": "Terminal to the coast",
      "tm": "От терминала к побережью"
    },
    "/routePhases/0/duration": {
      "source_en": "≈ 1 hr 35 min",
      "tm": "≈ 1 час 35 мин"
    },
    "/routePhases/0/description": {
      "source_en": "Cruise terminal pickup at 09:00 with a disembarkation buffer, then northeast along the coast to ⟦G0⟧ for a 09:45 arrival — ahead of the tour-bus surge that builds from mid-morning.",
      "tm": "Сбор у круизного терминала в 09:00 с запасом на сход с судна, затем на северо-восток вдоль побережья к ⟦G0⟧ с прибытием в 09:45 — до наплыва экскурсионных автобусов, который нарастает ближе к середине утра.",
      "glossary": [
        "⟦G0⟧ = Хэдон Йонгунса"
      ]
    },
    "/routePhases/1/phase": {
      "source_en": "Memorial and lunch",
      "tm": "Мемориал и обед"
    },
    "/routePhases/1/duration": {
      "source_en": "≈ 1 hr 40 min",
      "tm": "≈ 1 час 40 мин"
    },
    "/routePhases/1/description": {
      "source_en": "⟦G0⟧ (30 min) for Korean War context, then a Busan-specific lunch — dwaeji-gukbap or milmyeon — at your own expense.",
      "tm": "⟦G0⟧ (30 мин) ради контекста Корейской войны, затем типично пусанский обед — тведжи-кукпап или мильмён — за свой счёт.",
      "glossary": [
        "⟦G0⟧ = Мемориальное кладбище ООН"
      ]
    },
    "/routePhases/2/phase": {
      "source_en": "Nampo-dong on foot",
      "tm": "Нампходон пешком"
    },
    "/routePhases/2/duration": {
      "source_en": "≈ 1 hr 25 min",
      "tm": "≈ 1 час 25 мин"
    },
    "/routePhases/2/description": {
      "source_en": "⟦G0⟧, ⟦G2⟧ and ⟦G1⟧ are three separate stops within about 600 m of each other, so the middle of the day is walked rather than driven.",
      "tm": "⟦G0⟧, ⟦G2⟧ и ⟦G1⟧ — три отдельные остановки в пределах примерно 600 м друг от друга, поэтому середина дня проходит пешком, а не на колёсах.",
      "glossary": [
        "⟦G0⟧ = Рынок Чагальчхи",
        "⟦G1⟧ = Рынок Кукче",
        "⟦G2⟧ = Площадь BIFF"
      ]
    },
    "/routePhases/3/phase": {
      "source_en": "Gamcheon hillside",
      "tm": "Склон Камчхона"
    },
    "/routePhases/3/duration": {
      "source_en": "≈ 1 hr 5 min",
      "tm": "≈ 1 час 5 мин"
    },
    "/routePhases/3/description": {
      "source_en": "⟦G0⟧ (45 min) for the painted-house panorama, reached by a short transfer from Nampo-dong.",
      "tm": "⟦G0⟧ (45 мин) ради панорамы расписанных домов, куда ведёт короткий переезд из Нампходона.",
      "glossary": [
        "⟦G0⟧ = Деревня культуры Камчхон"
      ]
    },
    "/routePhases/4/phase": {
      "source_en": "Songdo and the return",
      "tm": "Сондо и возвращение"
    },
    "/routePhases/4/duration": {
      "source_en": "≈ 1 hr 35 min",
      "tm": "≈ 1 час 35 мин"
    },
    "/routePhases/4/description": {
      "source_en": "Songdo Cloud Trails skywalk, then Sky Park across the bay if you choose the cable car, and ⟦G0⟧ before the drive back — at the terminal by 17:00, and always timed to your ship's all-aboard.",
      "tm": "Скайвок Songdo Cloud Trails, затем Sky Park на другой стороне залива, если выберете канатную дорогу, и ⟦G0⟧ перед обратной дорогой — к терминалу к 17:00 и всегда с расчётом на время посадки на ваше судно.",
      "glossary": [
        "⟦G0⟧ = Парк Йондусан"
      ]
    },
