  "segments": {
    "/routePhases/0/phase": {
      "source_en": "Outbound + Ahopsan",
      "tm": "Anfahrt + Ahopsan"
    },
    "/routePhases/0/duration": {
      "source_en": "≈ 2.5 hours",
      "tm": "≈ 2,5 Stunden"
    },
    "/routePhases/0/description": {
      "source_en": "Pickup at three Busan subway stations (Busan Station Exit 4 at 08:10, Seomyeon Station Exit 4 at 08:30, Haeundae Station Exit 5 at 09:10), then ≈30 min to ⟦G0⟧ in Gijang and a 60-minute walk along the bamboo paths.",
      "tm": "Abholung an drei Busaner U-Bahn-Stationen (Busan Station Ausgang 4 um 08:10 Uhr, Seomyeon Station Ausgang 4 um 08:30 Uhr, Haeundae Station Ausgang 5 um 09:10 Uhr), dann ≈30 Min. bis zum ⟦G0⟧ in Gijang und ein 60-minütiger Spaziergang auf den Bambuswegen.",
      "glossary": [
        "⟦G0⟧ = Bambuswald Ahopsan"
      ]
    },
    "/routePhases/1/phase": {
      "source_en": "UNESCO core",
      "tm": "UNESCO-Kern"
    },
    "/routePhases/1/duration": {
      "source_en": "≈ 2 hours",
      "tm": "≈ 2 Stunden"
    },
    "/routePhases/1/description": {
      "source_en": "Drive ≈50 min from Ahopsan to Bulguksa, then 75 minutes walking the temple at a relaxed pace.",
      "tm": "Fahrt von ≈50 Min. von Ahopsan nach Bulguksa, danach 75 Minuten Rundgang durch die Tempelanlage in entspanntem Tempo."
    },
    "/routePhases/2/phase": {
      "source_en": "Lunch",
      "tm": "Mittagessen"
    },
    "/routePhases/2/duration": {
      "source_en": "≈ 1 hour",
      "tm": "≈ 1 Stunde"
    },
    "/routePhases/2/description": {
      "source_en": "Regional food such as ssambap at a local restaurant in central Gyeongju (≈55 min, paid individually).",
      "tm": "Regionale Küche wie Ssambap in einem lokalen Restaurant im Zentrum von Gyeongju (≈55 Min., individuell zu bezahlen)."
    },
    "/routePhases/3/phase": {
      "source_en": "Gyeongju walking block 1 — head family and bridge",
      "tm": "Gyeongju-Rundgang Teil 1 — Stammhaus und Brücke"
    },
    "/routePhases/3/duration": {
      "source_en": "≈ 1.5 hours",
      "tm": "≈ 1,5 Stunden"
    },
    "/routePhases/3/description": {
      "source_en": "From ⟦G0⟧ and the Choi Family House along the Namcheon riverside to ⟦G1⟧ — 75 minutes on a single drop-off.",
      "tm": "Vom ⟦G0⟧ und dem Haus der Familie Choi entlang des Namcheon-Ufers bis zur ⟦G1⟧ — 75 Minuten bei einmaligem Absetzen.",
      "glossary": [
        "⟦G0⟧ = Hanok-Dorf Gyochon",
        "⟦G1⟧ = Woljeonggyo-Brücke"
      ]
    },
    "/routePhases/4/phase": {
      "source_en": "Gyeongju walking block 2 — royal tombs and cafe street",
      "tm": "Gyeongju-Rundgang Teil 2 — Königsgräber und Cafészene"
    },
    "/routePhases/4/duration": {
      "source_en": "≈ 1.5 hours",
      "tm": "≈ 1,5 Stunden"
    },
    "/routePhases/4/description": {
      "source_en": "A walk among the Daereungwon mounds, then over the west wall into Hwangnidan-gil — 75 minutes on a single drop-off.",
      "tm": "Ein Spaziergang zwischen den Grabhügeln von Daereungwon, dann über den Westwall in die Hwangnidan-gil — 75 Minuten bei einmaligem Absetzen."
    },
    "/routePhases/5/phase": {
      "source_en": "Final stop + return",
      "tm": "Letzter Stopp + Rückfahrt"
    },
    "/routePhases/5/duration": {
      "source_en": "≈ 2.5 hours",
      "tm": "≈ 2,5 Stunden"
    },
    "/routePhases/5/description": {
      "source_en": "60 minutes at ⟦G0⟧ (Nov–Feb: Donggung & Wolji by night), then back to Busan on the Gyeongbu Expressway — Haeundae ≈19:15, Seomyeon ≈19:35, Busan Station ≈19:50.",
      "tm": "60 Minuten im ⟦G0⟧ (Nov.–Feb.: Donggung & Wolji bei Nacht), dann zurück nach Busan über die Gyeongbu-Autobahn — Haeundae ≈19:15 Uhr, Seomyeon ≈19:35 Uhr, Busan Station ≈19:50 Uhr.",
      "glossary": [
        "⟦G0⟧ = Nationalmuseum Gyeongju"
      ]
    },
