  "segments": {
    "/routePhases/0/phase": {
      "source_en": "Outbound + Ahopsan",
      "tm": "Дорога туда и Ахопсан"
    },
    "/routePhases/0/duration": {
      "source_en": "≈ 2.5 hours",
      "tm": "≈ 2,5 часа"
    },
    "/routePhases/0/description": {
      "source_en": "Pickup at three Busan subway stations (Busan Station Exit 4 at 08:10, Seomyeon Station Exit 4 at 08:30, Haeundae Station Exit 5 at 09:10), then ≈30 min to ⟦G0⟧ in Gijang and a 60-minute walk along the bamboo paths.",
      "tm": "Посадка на трёх станциях метро Пусана (станция Пусан, выход 4 в 08:10, станция Сомён, выход 4 в 08:30, станция Хэундэ, выход 5 в 09:10), затем ≈30 мин. до ⟦G0⟧ в Киджане и 60-минутная прогулка по бамбуковым тропам.",
      "glossary": [
        "⟦G0⟧ = Бамбуковый лес Ахопсан"
      ]
    },
    "/routePhases/1/phase": {
      "source_en": "UNESCO core",
      "tm": "Ядро ЮНЕСКО"
    },
    "/routePhases/1/duration": {
      "source_en": "≈ 2 hours",
      "tm": "≈ 2 часа"
    },
    "/routePhases/1/description": {
      "source_en": "Drive ≈50 min from Ahopsan to Bulguksa, then 75 minutes walking the temple at a relaxed pace.",
      "tm": "Переезд ≈50 мин. от Ахопсана до Пульгукса, затем 75 минут неспешной прогулки по храму."
    },
    "/routePhases/2/phase": {
      "source_en": "Lunch",
      "tm": "Обед"
    },
    "/routePhases/2/duration": {
      "source_en": "≈ 1 hour",
      "tm": "≈ 1 час"
    },
    "/routePhases/2/description": {
      "source_en": "Regional food such as ssambap at a local restaurant in central Gyeongju (≈55 min, paid individually).",
      "tm": "Местная кухня, например ссамбап, в местном ресторане в центре Кёнджу (≈55 мин., оплачивается отдельно)."
    },
    "/routePhases/3/phase": {
      "source_en": "Gyeongju walking block 1 — head family and bridge",
      "tm": "Пеший квартал Кёнджу 1 — главная семья и мост"
    },
    "/routePhases/3/duration": {
      "source_en": "≈ 1.5 hours",
      "tm": "≈ 1,5 часа"
    },
    "/routePhases/3/description": {
      "source_en": "From ⟦G0⟧ and the Choi Family House along the Namcheon riverside to ⟦G1⟧ — 75 minutes on a single drop-off.",
      "tm": "От ⟦G0⟧ и Дома семьи Чхве вдоль берега Намчхона к ⟦G1⟧ — 75 минут на одной высадке.",
      "glossary": [
        "⟦G0⟧ = Деревня ханок Кёчхон",
        "⟦G1⟧ = Мост Вольджонгё"
      ]
    },
    "/routePhases/4/phase": {
      "source_en": "Gyeongju walking block 2 — royal tombs and cafe street",
      "tm": "Пеший квартал Кёнджу 2 — королевские курганы и улица кафе"
    },
    "/routePhases/4/duration": {
      "source_en": "≈ 1.5 hours",
      "tm": "≈ 1,5 часа"
    },
    "/routePhases/4/description": {
      "source_en": "A walk among the Daereungwon mounds, then over the west wall into Hwangnidan-gil — 75 minutes on a single drop-off.",
      "tm": "Прогулка среди курганов Тэрынвона, затем через западную стену в Хваннидан-гиль — 75 минут на одной высадке."
    },
    "/routePhases/5/phase": {
      "source_en": "Final stop + return",
      "tm": "Последняя остановка и возвращение"
    },
    "/routePhases/5/duration": {
      "source_en": "≈ 2.5 hours",
      "tm": "≈ 2,5 часа"
    },
    "/routePhases/5/description": {
      "source_en": "60 minutes at ⟦G0⟧ (Nov–Feb: Donggung & Wolji by night), then back to Busan on the Gyeongbu Expressway — Haeundae ≈19:15, Seomyeon ≈19:35, Busan Station ≈19:50.",
      "tm": "60 минут в ⟦G0⟧ (ноябрь–февраль: Тонгун и Вольджи ночью), затем обратно в Пусан по скоростной автомагистрали Кёнбу — Хэундэ ≈19:15, Сомён ≈19:35, станция Пусан ≈19:50.",
      "glossary": [
        "⟦G0⟧ = Национальный музей Кёнджу"
      ]
    },
