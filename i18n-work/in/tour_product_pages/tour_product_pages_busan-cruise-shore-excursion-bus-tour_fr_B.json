  "locale": "fr",
  "chunk": "B",
  "tier": "B",
  "segments": {
    "/routePhases/0/phase": {
      "source_en": "Terminal to the coast",
      "tm": "Du terminal à la côte"
    },
    "/routePhases/0/duration": {
      "source_en": "≈ 1 hr 35 min",
      "tm": "≈ 1 h 35 min"
    },
    "/routePhases/0/description": {
      "source_en": "Cruise terminal pickup at 09:00 with a disembarkation buffer, then northeast along the coast to ⟦G0⟧ for a 09:45 arrival — ahead of the tour-bus surge that builds from mid-morning.",
      "tm": "Prise en charge au terminal de croisière à 09h00, avec une marge pour le débarquement, puis cap au nord-est le long de la côte jusqu’à ⟦G0⟧, pour une arrivée à 09h45 — avant l’afflux des autocars, qui monte à partir de la fin de matinée.",
      "glossary": [
        "⟦G0⟧ = Haedong Yonggungsa"
      ]
    },
    "/routePhases/1/phase": {
      "source_en": "Memorial and lunch",
      "tm": "Mémorial et déjeuner"
    },
    "/routePhases/1/duration": {
      "source_en": "≈ 1 hr 40 min",
      "tm": "≈ 1 h 40 min"
    },
    "/routePhases/1/description": {
      "source_en": "⟦G0⟧ (30 min) for Korean War context, then a Busan-specific lunch — dwaeji-gukbap or milmyeon — at your own expense.",
      "tm": "⟦G0⟧ (30 min) pour le contexte de la guerre de Corée, puis un déjeuner typiquement busanais — dwaeji-gukbap ou milmyeon — à votre charge.",
      "glossary": [
        "⟦G0⟧ = Cimetière commémoratif de l'ONU"
      ]
    },
    "/routePhases/2/phase": {
      "source_en": "Nampo-dong on foot",
      "tm": "Nampo-dong à pied"
    },
    "/routePhases/2/duration": {
      "source_en": "≈ 1 hr 25 min",
      "tm": "≈ 1 h 25 min"
    },
    "/routePhases/2/description": {
      "source_en": "⟦G0⟧, ⟦G2⟧ and ⟦G1⟧ are three separate stops within about 600 m of each other, so the middle of the day is walked rather than driven.",
      "tm": "⟦G0⟧, ⟦G2⟧ et ⟦G1⟧ sont trois étapes distinctes situées à environ 600 m les unes des autres : le milieu de journée se fait donc à pied plutôt qu’en véhicule.",
      "glossary": [
        "⟦G0⟧ = Marché Jagalchi",
        "⟦G1⟧ = Marché Gukje",
        "⟦G2⟧ = BIFF Square"
      ]
    },
    "/routePhases/3/phase": {
      "source_en": "Gamcheon hillside",
      "tm": "La colline de Gamcheon"
    },
    "/routePhases/3/duration": {
      "source_en": "≈ 1 hr 5 min",
      "tm": "≈ 1 h 5 min"
    },
    "/routePhases/3/description": {
      "source_en": "⟦G0⟧ (45 min) for the painted-house panorama, reached by a short transfer from Nampo-dong.",
      "tm": "⟦G0⟧ (45 min) pour le panorama des maisons peintes, à quelques minutes de route de Nampo-dong.",
      "glossary": [
        "⟦G0⟧ = Village culturel de Gamcheon"
      ]
    },
    "/routePhases/4/phase": {
      "source_en": "Songdo and the return",
      "tm": "Songdo et le retour"
    },
    "/routePhases/4/duration": {
      "source_en": "≈ 1 hr 35 min",
      "tm": "≈ 1 h 35 min"
    },
    "/routePhases/4/description": {
      "source_en": "Songdo Cloud Trails skywalk, then Sky Park across the bay if you choose the cable car, and ⟦G0⟧ before the drive back — at the terminal by 17:00, and always timed to your ship's all-aboard.",
      "tm": "La passerelle Songdo Cloud Trails, puis le Sky Park de l'autre côté de la baie si vous choisissez le téléphérique, et ⟦G0⟧ avant la route du retour — au terminal à 17h00, et toujours calé sur l'heure d'embarquement final de votre navire.",
      "glossary": [
        "⟦G0⟧ = Parc Yongdusan"
      ]
    },
