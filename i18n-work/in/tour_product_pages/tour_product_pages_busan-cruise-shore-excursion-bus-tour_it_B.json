{
  "unitId": "tour_product_pages:busan-cruise-shore-excursion-bus-tour:it:B",
  "surface": "tour_product_pages",
  "slug": "busan-cruise-shore-excursion-bus-tour",
  "locale": "it",
  "chunk": "B",
  "tier": "B",
  "segments": {
    "/routePhases/0/phase": {
      "source_en": "Terminal to the coast",
      "tm": "Dal terminal alla costa"
    },
    "/routePhases/0/duration": {
      "source_en": "≈ 1 hr 35 min",
      "tm": "≈ 1 ora e 35 min"
    },
    "/routePhases/0/description": {
      "source_en": "Cruise terminal pickup at 09:00 with a disembarkation buffer, then northeast along the coast to ⟦G0⟧ for a 09:45 arrival — ahead of the tour-bus surge that builds from mid-morning.",
      "tm": "Prelievo al terminal crociere alle 09:00, con un margine per lo sbarco, poi verso nord-est lungo la costa fino a ⟦G0⟧, con arrivo alle 09:45 — prima dell’ondata di pullman turistici che cresce da metà mattina.",
      "glossary": [
        "⟦G0⟧ = Haedong Yonggungsa"
      ]
    },
    "/routePhases/1/phase": {
      "source_en": "Memorial and lunch",
      "tm": "Memoriale e pranzo"
    },
    "/routePhases/1/duration": {
      "source_en": "≈ 1 hr 40 min",
      "tm": "≈ 1 ora e 40 min"
    },
    "/routePhases/1/description": {
      "source_en": "⟦G0⟧ (30 min) for Korean War context, then a Busan-specific lunch — dwaeji-gukbap or milmyeon — at your own expense.",
      "tm": "Il ⟦G0⟧ (30 min) per il contesto della guerra di Corea, poi un pranzo tipico di Busan — dwaeji-gukbap o milmyeon — a Suo carico.",
      "glossary": [
        "⟦G0⟧ = Cimitero commemorativo delle Nazioni Unite"
      ]
    },
    "/routePhases/2/phase": {
      "source_en": "Nampo-dong on foot",
      "tm": "Nampo-dong a piedi"
    },
    "/routePhases/2/duration": {
      "source_en": "≈ 1 hr 25 min",
      "tm": "≈ 1 ora e 25 min"
    },
    "/routePhases/2/description": {
      "source_en": "⟦G0⟧, ⟦G2⟧ and ⟦G1⟧ are three separate stops within about 600 m of each other, so the middle of the day is walked rather than driven.",
      "tm": "Il ⟦G0⟧, la ⟦G2⟧ e il ⟦G1⟧ sono tre tappe distinte entro circa 600 m l’una dall’altra: la parte centrale della giornata si percorre quindi a piedi, non in van.",
      "glossary": [
        "⟦G0⟧ = Mercato Jagalchi",
        "⟦G1⟧ = Mercato Gukje",
        "⟦G2⟧ = Piazza BIFF"
      ]
    },
    "/routePhases/3/phase": {
      "source_en": "Gamcheon hillside",
      "tm": "La collina di Gamcheon"
    },
    "/routePhases/3/duration": {
      "source_en": "≈ 1 hr 5 min",
      "tm": "≈ 1 ora e 5 min"
    },
    "/routePhases/3/description": {
      "source_en": "⟦G0⟧ (45 min) for the painted-house panorama, reached by a short transfer from Nampo-dong.",
      "tm": "Il ⟦G0⟧ (45 min) per il panorama delle case dipinte, raggiunto con un breve trasferimento da Nampo-dong.",
      "glossary": [
        "⟦G0⟧ = Villaggio culturale di Gamcheon"
      ]
    },
    "/routePhases/4/phase": {
      "source_en": "Songdo and the return",
      "tm": "Songdo e il rientro"
    },
    "/routePhases/4/duration": {
      "source_en": "≈ 1 hr 35 min",
      "tm": "≈ 1 ora e 35 min"
    },
    "/routePhases/4/description": {
      "source_en": "Songdo Cloud Trails skywalk, then Sky Park across the bay if you choose the cable car, and ⟦G0⟧ before the drive back — at the terminal by 17:00, and always timed to your ship's all-aboard.",
      "tm": "La passerella Songdo Cloud Trails, poi lo Sky Park dall’altra parte della baia se sceglie la funivia, e il ⟦G0⟧ prima del viaggio di ritorno — al terminal entro le 17:00, e sempre calibrato sull’orario di rientro a bordo della Sua nave.",
      "glossary": [
        "⟦G0⟧ = Parco di Yongdusan"
      ]
    },
