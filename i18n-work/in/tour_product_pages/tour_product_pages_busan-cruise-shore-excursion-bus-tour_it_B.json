    "/routePhases/0/phase": {
      "source_en": "Coastal morning"
    },
    "/routePhases/0/duration": {
      "source_en": "≈ 2.5 hours"
    },
    "/routePhases/0/description": {
      "source_en": "Cruise terminal pickup at 08:30, drive northeast to ⟦G0⟧ Temple for the 09:30 arrival before the worst tour-bus crowds.",
      "glossary": [
        "⟦G0⟧ = Haedong Yonggungsa"
      ]
    },
    "/routePhases/1/phase": {
      "source_en": "Memorial & lunch"
    },
    "/routePhases/1/duration": {
      "source_en": "≈ 2 hours"
    },
    "/routePhases/1/description": {
      "source_en": "⟦G0⟧ (60 min) for Korean War context, then an optional 60-min Busan-specific lunch (dwaeji-gukbap or milmyeon).",
      "glossary": [
        "⟦G0⟧ = Cimitero commemorativo delle Nazioni Unite"
      ]
    },
    "/routePhases/2/phase": {
      "source_en": "Nampo-dong cluster"
    },
    "/routePhases/2/duration": {
      "source_en": "≈ 1.5 hours"
    },
    "/routePhases/2/description": {
      "source_en": "⟦G0⟧ → ⟦G2⟧ → ⟦G1⟧ — three short adjacent stops covering Busan's food, film, and refugee-market heritage within 600 m walking radius.",
      "glossary": [
        "⟦G0⟧ = Mercato Jagalchi",
        "⟦G1⟧ = Mercato Gukje",
        "⟦G2⟧ = Piazza BIFF"
      ]
    },
    "/routePhases/3/phase": {
      "source_en": "Village & coast"
    },
    "/routePhases/3/duration": {
      "source_en": "≈ 2 hours"
    },
    "/routePhases/3/description": {
      "source_en": "⟦G0⟧ (90 min at golden hour) for the rainbow-roof panorama, then ⟦G1⟧ (30 min) for the cable-car coastline shot.",
      "glossary": [
        "⟦G0⟧ = Villaggio culturale di Gamcheon",
        "⟦G1⟧ = Spiaggia di Songdo"
      ]
    },
    "/routePhases/4/phase": {
      "source_en": "Twilight viewpoint & return"
    },
    "/routePhases/4/duration": {
      "source_en": "≈ 1 hour"
    },
    "/routePhases/4/description": {
      "source_en": "⟦G0⟧ & Busan Diamond Tower at twilight (30 min), then the ~15-min drive back to the cruise terminal for 19:30 reboarding.",
      "glossary": [
        "⟦G0⟧ = Parco di Yongdusan"
      ]
