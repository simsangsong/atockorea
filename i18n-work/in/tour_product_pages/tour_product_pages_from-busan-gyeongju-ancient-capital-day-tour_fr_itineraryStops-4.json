    "/itineraryStops/5/name": {
      "source_en": "⟦G0⟧ & Hwangnidan-gil",
      "glossary": [
        "⟦G0⟧ = Complexe de tombes de Daereungwon"
      ]
    },
    "/itineraryStops/5/category": {
      "source_en": "Silla royal tomb park + hanok cafe street (walked, one drop-off)"
    },
    "/itineraryStops/5/duration": {
      "source_en": "75 min"
    },
    "/itineraryStops/5/timeUsed/0": {
      "source_en": "Enter at the Daereungwon main gate + walk among the mounds (≈25 min)"
    },
    "/itineraryStops/5/timeUsed/1": {
      "source_en": "Cheonmachong interior (optional, ≈15 min)"
    },
    "/itineraryStops/5/timeUsed/2": {
      "source_en": "Out through the west gate → into Hwangnidan-gil (≈5 min)"
    },
    "/itineraryStops/5/timeUsed/3": {
      "source_en": "Free time in the Hwangnidan-gil cafes and shops (≈20 min)"
    },
    "/itineraryStops/5/timeUsed/4": {
      "source_en": "Hwangnam bread and other souvenirs + reassemble (≈10 min)"
    },
    "/itineraryStops/5/highlights/0": {
      "source_en": "**Daereungwon = 23 Silla royal tombs across 126,500 m²** (4th–6th centuries)"
    },
    "/itineraryStops/5/highlights/1": {
      "source_en": "**Cheonmachong (Tomb 155)** — excavated April 16, 1973, **the only interior open to visitors**, **11,526 artifacts**"
    },
    "/itineraryStops/5/highlights/2": {
      "source_en": "**Cheonmado = the only surviving Silla-era painting** · Cheonmachong Gold Crown = **National Treasure No. 188**"
    },
    "/itineraryStops/5/highlights/3": {
      "source_en": "**Hwangnamdaechong** — the complex's largest, a king and queen buried together. Queen's crown pendants **3 pairs** > the king's one"
    },
    "/itineraryStops/5/highlights/4": {
      "source_en": "**Free park admission** (Cheonmachong interior adult ₩3,000) · flat grass paths, easy for strollers and older guests"
    },
    "/itineraryStops/5/highlights/5": {
      "source_en": "**Hwangnidan-gil = 'Hwangnam-dong's Gyeongnidan-gil'** — Hwangnam-dong + Gyeongnidan-gil"
    },
    "/itineraryStops/5/highlights/6": {
      "source_en": "**Straight across Daereungwon's west wall** — Naenam Intersection to Hwangnam Elementary School intersection"
    },
    "/itineraryStops/5/highlights/7": {
      "source_en": "A street of **hanok-converted cafes, studios and gift shops**, Gyeongju's youngest since around 2017"
    },
    "/itineraryStops/5/highlights/8": {
      "source_en": "**Hwangnam bread = first made in 1939 in Hwangnam-dong by Choi Yeong-hwa** — this is the neighbourhood it came from"
    },
    "/itineraryStops/5/smartNotes/tip": {
      "source_en": "Climbing the mounds is prohibited (fines apply). The Daereungwon walk takes 30–60 minutes, and the west gate opens straight onto Hwangnidan-gil. The original Hwangnam bread shop is in this neighbourhood and the queue is long on weekend afternoons."
    },
    "/itineraryStops/5/smartNotes/facilities": {
      "source_en": "A small exhibit inside Cheonmachong (Cheonmado replica and grave goods) · combined Daereungwon + Donggung & Wolji day pass on sale (₩4,000–8,000) · plenty of cafes and gift shops on Hwangnidan-gil"
    }
  },
