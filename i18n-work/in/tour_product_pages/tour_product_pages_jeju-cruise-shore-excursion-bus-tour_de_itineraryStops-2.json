    "/itineraryStops/2/smartNotes/facilities": {
      "source_en": "Aqua Planet Jeju aquarium and several cafés on site"
    },
    "/itineraryStops/2/whyOnRoute": {
      "source_en": "**⟦G0⟧ adds an easy coastal-walk section after Seongsan.** The cape gives guests a different angle on eastern Jeju: sea cliffs, lighthouse views, open grassland, and contemporary architecture near the coastline. It is placed here because it is close to Seongsan and keeps the morning route efficient before lunch. The stop is scenic but flexible, so the guide can shorten or extend the walk depending on wind, weather, and cruise-day timing.",
      "glossary": [
        "⟦G0⟧ = Seopjikoji"
      ]
    },
    "/itineraryStops/2/convenience/parking": {
      "source_en": "Free parking available"
    },
    "/itineraryStops/2/convenience/restroom": {
      "source_en": "Available at parking lot and Aqua Planet area"
    },
    "/itineraryStops/2/description": {
      "source_en": "**⟦G1⟧ (섭지코지)** is a narrow volcanic cape on Jeju's east coast. In Jeju dialect, **koji** means a cape or headland, and the place is known for open sea views, a gentle coastal path, the white lighthouse, and the broad view back toward ⟦G0⟧. \n\nThe walk is scenic without being a heavy hike, so it works well for cruise guests who want strong photos and fresh sea air without spending the whole day climbing. Depending on time, guests may also see the Glass House area and the Yumin Art Museum exterior, both associated with architect Tadao Ando. \n\nThe visit is kept flexible because wind, rain, gallery hours, and group walking speed can affect how much of the cape is covered.",
      "glossary": [
        "⟦G0⟧ = Seongsan Ilchulbong",
        "⟦G1⟧ = Seopjikoji"
      ]
    },
    "/itineraryStops/2/visitBasics/hours": {
      "source_en": "Open 24 hours (outdoor cape)"
    },
    "/itineraryStops/2/visitBasics/closed": {
      "source_en": "Open year-round"
    },
    "/itineraryStops/2/visitBasics/walking": {
      "source_en": "Easy to moderate — flat coastal walkway; total loop ≈ 1 hour"
    },
    "/itineraryStops/2/visitBasics/admission": {
      "source_en": "Free"
    },
