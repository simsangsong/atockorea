    },
    "/itineraryStops/2/highlights/1": {
      "source_en": "**Bangdupo Lighthouse** — octagonal, **flashes every 4 sec**, atop Bulgeun Oreum red volcanic cone"
    },
    "/itineraryStops/2/highlights/2": {
      "source_en": "**Hyeopja Yeondae Beacon Fire Station** — 4 m × 9 m Joseon yeondae, **Special Monument No. 23-2**"
    },
    "/itineraryStops/2/highlights/3": {
      "source_en": "**Tadao Ando architecture** — Glass House restaurant + Yumin Art Gallery (Phoenix Island)"
    },
    "/itineraryStops/2/highlights/4": {
      "source_en": "**Seonbawi (Seon Rock)** — 10 m offshore volcanic neck, dragon king's youngest son legend"
    },
    "/itineraryStops/2/highlights/5": {
      "source_en": "**Drama filming**: 'All In' (2003), 'My Girl' (2005), and others"
    },
    "/itineraryStops/2/highlights/6": {
      "source_en": "**Canola season March–April** (yellow slopes); **hydrangea June** (blue/violet)"
    },
    "/itineraryStops/2/highlights/7": {
      "source_en": "**FREE cape admission**; Yumin Art Gallery + Glass House separately ticketed"
    },
    "/itineraryStops/2/highlights/8": {
      "source_en": "⟦G0⟧ **clearly visible 4 km north** from the cape tip — perfect Triple-UNESCO panorama backdrop",
