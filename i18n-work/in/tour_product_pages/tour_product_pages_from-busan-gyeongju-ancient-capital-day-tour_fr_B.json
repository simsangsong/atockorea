  "segments": {
    "/routePhases/0/phase": {
      "source_en": "Outbound + Ahopsan",
      "tm": "Trajet aller + Ahopsan"
    },
    "/routePhases/0/duration": {
      "source_en": "≈ 2.5 hours",
      "tm": "≈ 2,5 heures"
    },
    "/routePhases/0/description": {
      "source_en": "Pickup at three Busan subway stations (Busan Station Exit 4 at 08:10, Seomyeon Station Exit 4 at 08:30, Haeundae Station Exit 5 at 09:10), then ≈30 min to ⟦G0⟧ in Gijang and a 60-minute walk along the bamboo paths.",
      "tm": "Prise en charge à trois stations de métro de Busan (Busan Station sortie 4 à 08:10, Seomyeon Station sortie 4 à 08:30, Haeundae Station sortie 5 à 09:10), puis ≈30 min jusqu'à ⟦G0⟧ à Gijang et 60 minutes de marche le long des sentiers de bambous.",
      "glossary": [
        "⟦G0⟧ = Forêt de bambous d'Ahopsan"
      ]
    },
    "/routePhases/1/phase": {
      "source_en": "UNESCO core",
      "tm": "Cœur UNESCO"
    },
    "/routePhases/1/duration": {
      "source_en": "≈ 2 hours",
      "tm": "≈ 2 heures"
    },
    "/routePhases/1/description": {
      "source_en": "Drive ≈50 min from Ahopsan to Bulguksa, then 75 minutes walking the temple at a relaxed pace.",
      "tm": "Trajet d'≈50 min d'Ahopsan à Bulguksa, puis 75 minutes de visite du temple à pied, à un rythme tranquille."
    },
    "/routePhases/2/phase": {
      "source_en": "Lunch",
      "tm": "Déjeuner"
    },
    "/routePhases/2/duration": {
      "source_en": "≈ 1 hour",
      "tm": "≈ 1 heure"
    },
    "/routePhases/2/description": {
      "source_en": "Regional food such as ssambap at a local restaurant in central Gyeongju (≈55 min, paid individually).",
      "tm": "Cuisine régionale comme le ssambap dans un restaurant local du centre de Gyeongju (≈55 min, à régler individuellement)."
    },
    "/routePhases/3/phase": {
      "source_en": "Gyeongju walking block 1 — head family and bridge",
      "tm": "Bloc de marche à Gyeongju 1 — maison de famille principale et pont"
    },
    "/routePhases/3/duration": {
      "source_en": "≈ 1.5 hours",
      "tm": "≈ 1,5 heure"
    },
    "/routePhases/3/description": {
      "source_en": "From ⟦G0⟧ and the Choi Family House along the Namcheon riverside to ⟦G1⟧ — 75 minutes on a single drop-off.",
      "tm": "De ⟦G0⟧ et la maison de la famille Choi, le long des rives du Namcheon jusqu'au ⟦G1⟧ — 75 minutes sur une seule dépose.",
      "glossary": [
        "⟦G0⟧ = Village hanok de Gyochon",
        "⟦G1⟧ = Pont Woljeonggyo"
      ]
    },
    "/routePhases/4/phase": {
      "source_en": "Gyeongju walking block 2 — royal tombs and cafe street",
      "tm": "Bloc de marche à Gyeongju 2 — tombes royales et rue des cafés"
    },
    "/routePhases/4/duration": {
      "source_en": "≈ 1.5 hours",
      "tm": "≈ 1,5 heure"
    },
    "/routePhases/4/description": {
      "source_en": "A walk among the Daereungwon mounds, then over the west wall into Hwangnidan-gil — 75 minutes on a single drop-off.",
      "tm": "Une promenade parmi les tumulus de Daereungwon, puis passage par le mur ouest vers Hwangnidan-gil — 75 minutes sur une seule dépose."
    },
    "/routePhases/5/phase": {
      "source_en": "Final stop + return",
      "tm": "Dernière étape + retour"
    },
    "/routePhases/5/duration": {
      "source_en": "≈ 2.5 hours",
      "tm": "≈ 2,5 heures"
    },
    "/routePhases/5/description": {
      "source_en": "60 minutes at ⟦G0⟧ (Nov–Feb: Donggung & Wolji by night), then back to Busan on the Gyeongbu Expressway — Haeundae ≈19:15, Seomyeon ≈19:35, Busan Station ≈19:50.",
      "tm": "60 minutes au ⟦G0⟧ (nov.–févr. : Donggung & Wolji de nuit), puis retour à Busan par l'autoroute Gyeongbu — Haeundae ≈19:15, Seomyeon ≈19:35, Busan Station ≈19:50.",
      "glossary": [
        "⟦G0⟧ = Musée national de Gyeongju"
      ]
    },
