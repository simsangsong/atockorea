  "segments": {
    "/routePhases/0/phase": {
      "source_en": "Seoul → Seoraksan",
      "tm": "Сеул → Сораксан"
    },
    "/routePhases/0/duration": {
      "source_en": "≈ 3.5 hours"
    },
    "/routePhases/0/description": {
      "source_en": "Pickup at 06:00 Hongik / 06:30 ⟦G0⟧, then a ~3-hour drive northeast on the Seoul-Yangyang Expressway with one comfort stop, arriving at the Sogongwon entrance around 09:30.",
      "glossary": [
        "⟦G0⟧ = Мёндон"
      ]
    },
    "/routePhases/1/phase": {
      "source_en": "Seoraksan",
      "tm": "Сораксан"
    },
    "/routePhases/1/duration": {
      "source_en": "≈ 2 hours",
      "tm": "≈ 2 часа"
    },
    "/routePhases/1/description": {
      "source_en": "Self-guided time at the Sogongwon entrance: the Tongildaebul bronze Buddha, Sinheungsa Temple, and the lower valley paths under snow. The cable car is not included and runs only when wind and ice allow."
    },
    "/routePhases/2/phase": {
      "source_en": "Lunch → Nami Island"
    },
    "/routePhases/2/duration": {
      "source_en": "≈ 3 hours",
      "tm": "≈ 3 часа"
    },
    "/routePhases/2/description": {
      "source_en": "Lunch near Sokcho (own expense), then the ~2-hour drive back west to Gapyeong Wharf and the five-minute ferry to Nami Island for two hours among the frosted metasequoia avenues."
    },
    "/routePhases/3/phase": {
      "source_en": "Eobi Valley → Seoul"
    },
    "/routePhases/3/duration": {
      "source_en": "≈ 2.5 hours",
      "tm": "≈ 2,5 часа"
    },
    "/routePhases/3/description": {
      "source_en": "Forty minutes south to Eobi Valley for the ice wall in late-afternoon light, then the ~1.5-hour run into Seoul — ⟦G0⟧ around 19:00, Hongik around 19:30.",
      "glossary": [
        "⟦G0⟧ = Мёндон"
      ]
