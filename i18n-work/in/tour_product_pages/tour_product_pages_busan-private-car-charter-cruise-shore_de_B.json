  "segments": {
    "/routePhases/0/title": {
      "source_en": "Memory and the Sea",
      "tm": "Erinnerung und das Meer"
    },
    "/routePhases/0/summary": {
      "source_en": "Quiet morning at ⟦G0⟧, then dramatic East Sea cliffs at ⟦G1⟧. Reflective and scenic, away from crowds.",
      "tm": "Ruhiger Vormittag am ⟦G0⟧, danach eindrucksvolle Klippen am Ostmeer bei ⟦G1⟧. Besinnlich und landschaftlich reizvoll, abseits der Menschenmengen.",
      "glossary": [
        "⟦G0⟧ = UN-Gedenkfriedhof",
        "⟦G1⟧ = Taejongdae"
      ]
    },
    "/routePhases/1/title": {
      "source_en": "Color, Heights, and Harbor",
      "tm": "Farbe, Höhen und Hafen"
    },
    "/routePhases/1/summary": {
      "source_en": "After lunch, climb into Gamcheon's painted alleys, then up ⟦G1⟧ for downtown panoramas, ending at ⟦G0⟧ by the working harbor.",
      "tm": "Nach dem Mittagessen geht es hinauf in Gamcheons bemalte Gassen, danach zum ⟦G1⟧ für Panoramablicke über die Innenstadt; den Abschluss bildet der ⟦G0⟧ am aktiven Hafen.",
      "glossary": [
        "⟦G0⟧ = Jagalchi-Markt",
        "⟦G1⟧ = Yongdusan-Park"
      ]
    },
    "/routePhases/2/title": {
      "source_en": "Return Planned Around Ship Time",
      "tm": "Rückfahrt nach Schiffszeit geplant"
    },
    "/routePhases/2/summary": {
      "source_en": "Direct drive back to the cruise terminal with planned extra time before the ship's all-aboard call.",
      "tm": "Direkte Rückfahrt zum Kreuzfahrtterminal mit eingeplanter Pufferzeit vor dem letzten Einschiffungsaufruf des Schiffes."
    },
