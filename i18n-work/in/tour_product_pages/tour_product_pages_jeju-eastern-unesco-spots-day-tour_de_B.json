  "segments": {
    "/routePhases/0/phase": {
      "source_en": "Pickup and eastbound departure",
      "tm": "Abholung und Aufbruch nach Osten"
    },
    "/routePhases/0/duration": {
      "source_en": "about 1 hour",
      "tm": "etwa 1 Stunde"
    },
    "/routePhases/0/description": {
      "source_en": "Pickup at four points across Jeju City (08:30–09:05), then a direct transfer east to the ⟦G0⟧ in Gimnyeong.",
      "tm": "Abholung an vier Punkten in Jeju City (08:30–09:05 Uhr), dann direkt ostwärts zum ⟦G0⟧ in Gimnyeong.",
      "glossary": [
        "⟦G0⟧ = Manjanggul-Lavaröhre"
      ]
    },
    "/routePhases/1/phase": {
      "source_en": "UNESCO lava tube before the crowds",
      "tm": "UNESCO-Lavaröhre vor dem Andrang"
    },
    "/routePhases/1/duration": {
      "source_en": "about 1.5 hours",
      "tm": "etwa 1,5 Stunden"
    },
    "/routePhases/1/description": {
      "source_en": "⟦G0⟧ (UNESCO World Natural Heritage, 55 min) right after opening — the quietest hour inside the cave — then inland to Seongeup.",
      "tm": "⟦G0⟧ (UNESCO-Weltnaturerbe, 55 Min.) direkt nach der Öffnung — die ruhigste Stunde in der Höhle — dann landeinwärts nach Seongeup.",
      "glossary": [
        "⟦G0⟧ = Manjanggul-Lavaröhre"
      ]
    },
    "/routePhases/2/phase": {
      "source_en": "Joseon heritage village + lunch",
      "tm": "Erbedorf der Joseon-Zeit + Mittagessen"
    },
    "/routePhases/2/duration": {
      "source_en": "about 2 hours",
      "tm": "etwa 2 Stunden"
    },
    "/routePhases/2/description": {
      "source_en": "⟦G0⟧ (Joseon-era National Folklore Cultural Heritage, 60 min) → local restaurant near Seongsan — black pig, abalone hot pot, seasonal seafood. Lunch not included.",
      "tm": "⟦G0⟧ (nationales Volkskulturerbe der Joseon-Zeit, 60 Min.) → lokales Restaurant bei Seongsan — Schwarzschwein, Abalone-Eintopf, saisonale Meeresfrüchte. Mittagessen nicht inklusive.",
      "glossary": [
        "⟦G0⟧ = Folkloredorf Seongeup"
      ]
    },
    "/routePhases/3/phase": {
      "source_en": "Seongsan UNESCO core + haenyeo",
      "tm": "UNESCO-Kern Seongsan + Haenyeo"
    },
    "/routePhases/3/duration": {
      "source_en": "about 2.5 hours",
      "tm": "etwa 2,5 Stunden"
    },
    "/routePhases/3/description": {
      "source_en": "⟦G0⟧ (optional climb) → haenyeo diving performance in the sea below the peak (Haenyeo Museum if canceled).",
      "tm": "⟦G0⟧ (optionaler Aufstieg) → Haenyeo-Tauchvorführung im Meer unterhalb des Gipfels (bei Absage das Haenyeo-Museum).",
      "glossary": [
        "⟦G0⟧ = Seongsan Ilchulbong"
      ]
    },
    "/routePhases/4/phase": {
      "source_en": "Beach finale and return",
      "tm": "Abschluss am Strand und Rückfahrt"
    },
    "/routePhases/4/duration": {
      "source_en": "about 2 hours",
      "tm": "etwa 2 Stunden"
    },
    "/routePhases/4/description": {
      "source_en": "⟦G0⟧ in the late-afternoon light (60 min) → short coastal transfer back to Jeju City + drop-off at two points and Dongmun Market.",
      "tm": "⟦G0⟧ im Licht des späten Nachmittags (60 Min.) → kurze Küstenfahrt zurück nach Jeju City + Ausstieg an zwei Punkten und am Dongmun-Markt.",
      "glossary": [
        "⟦G0⟧ = Hamdeok-Seoubong-Strand"
      ]
    },
