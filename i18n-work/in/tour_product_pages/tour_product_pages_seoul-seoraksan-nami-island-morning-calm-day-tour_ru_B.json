  "segments": {
    "/routePhases/0/phase": {
      "source_en": "Seoul → Seoraksan",
      "tm": "Сеул → Сораксан"
    },
    "/routePhases/0/duration": {
      "source_en": "≈ 3 hours",
      "tm": "≈ 3 часа"
    },
    "/routePhases/0/description": {
      "source_en": "Pickup at 06:00 Hongik / 06:30 ⟦G0⟧, then ~2.5-hour drive northeast via Seoul-Yangyang Expressway to arrive Seoraksan by 10:00.",
      "tm": "Сбор в 06:00 у Hongik / в 06:30 в ⟦G0⟧, затем ~2,5 часа пути на северо-восток по автомагистрали Сеул–Янъян — прибытие в Сораксан к 10:00.",
      "glossary": [
        "⟦G0⟧ = Мёндон"
      ]
    },
    "/routePhases/1/phase": {
      "source_en": "Seoraksan",
      "tm": "Сораксан"
    },
    "/routePhases/1/duration": {
      "source_en": "≈ 3 hours",
      "tm": "≈ 3 часа"
    },
    "/routePhases/1/description": {
      "source_en": "Sogongwon entrance: Tongildaebul, Sinheungsa Temple, and optional cable car to Gwongeumseong or Biseondae streamside walk.",
      "tm": "Вход Согонвон: Тхонъильдэбуль, храм Синхынса и — по желанию — канатная дорога до Квонгымсона или прогулка вдоль ручья к Писондэ."
    },
    "/routePhases/2/phase": {
      "source_en": "Seoraksan → Nami (incl. lunch)",
      "tm": "Сораксан → Нами (с обедом)"
    },
    "/routePhases/2/duration": {
      "source_en": "≈ 2.5 hours",
      "tm": "≈ 2,5 часа"
    },
    "/routePhases/2/description": {
      "source_en": "Drive south via Inje-Hongcheon-Chuncheon corridor; lunch stop at a local Gangwon restaurant en route (own expense).",
      "tm": "Путь на юг по коридору Индже–Хончхон–Чхунчхон; остановка на обед по дороге в местном ресторане в Канвоне (за свой счёт)."
    },
    "/routePhases/3/phase": {
      "source_en": "Nami Island",
      "tm": "Остров Нами"
    },
    "/routePhases/3/duration": {
      "source_en": "≈ 2 hours",
      "tm": "≈ 2 часа"
    },
    "/routePhases/3/description": {
      "source_en": "Ferry round-trip and Metasequoia / Ginkgo / Korean Pine avenues walking circuit on Naminara Republic.",
      "tm": "Паром туда и обратно и пеший круг по аллеям метасеквой, гинкго и корейской сосны в Республике Наминара."
    },
